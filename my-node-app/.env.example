# =================================================================
# SMR MOTORS - FLASK & RENDER ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure with your credentials.
# =================================================================

# Server & Security
PORT=5000
FLASK_ENV=development
JWT_SECRET=replace_with_a_random_secret

# -----------------------------------------------------------------
# 1. TiDB Cloud MySQL-Compatible Database Connectivity
# -----------------------------------------------------------------
# Obtain cluster connection string from https://tidbcloud.com
DB_HOST=your_tidb_host
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=smr_motors
DB_SSL=true
DB_SSL_CA=certs/isrgrootx1.pem
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------
# 2. Google OAuth 2.0 Authentication
# -----------------------------------------------------------------
# Create an OAuth 2.0 Web Application client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript Origins:
#   - http://localhost:5000
#   - https://bike-selling-site-lco8.onrender.com
#
# Authorized Redirect URIs:
#   - http://localhost:5000/api/auth/google/callback
#   - https://bike-selling-site-lco8.onrender.com/api/auth/google/callback
#
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------
# 3. SMTP & Showroom Notification Configuration
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
CONTACT_RECEIVER_EMAIL=praja055@gmail.com
