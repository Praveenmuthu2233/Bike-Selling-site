# =================================================================
# SMR MOTORS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your credentials.
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=smr_motors_super_secure_jwt_secret_change_in_production_2025

# -----------------------------------------------------------------
# 1. TiDB Cloud MySQL-Compatible Database Connectivity
# -----------------------------------------------------------------
# Get your cluster connection string from https://tidbcloud.com
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=smr_motors
TIDB_SSL=true
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------
# 2. Google OAuth 2.0 Authentication
# -----------------------------------------------------------------
# Create OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:5000
# Authorized Redirect URIs: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------
# 3. Secure Administrator Credentials
# -----------------------------------------------------------------
# Admin login is isolated from Google Auth.
# Generate a new password hash using: npm run seed-admin <username> <email> <password>
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smrmotors.com
ADMIN_PASSWORD_HASH=$2b$10$wT8K8U9NZb2E9p8iFqVvte7h1C1Y8fN9M.vYy4F7ZpWvXy4e.XJ6K
