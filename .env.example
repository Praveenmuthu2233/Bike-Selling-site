# =================================================================
# SMR MOTORS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your credentials.
# =================================================================

# Server & Security
PORT=5000
NODE_ENV=development
FLASK_ENV=development
JWT_SECRET=replace_with_a_random_secret

# -----------------------------------------------------------------
# 1. TiDB Cloud MySQL-Compatible Database Connectivity
# -----------------------------------------------------------------
# Get your cluster connection string from https://tidbcloud.com
TIDB_HOST=your_tidb_host
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=smr_motors
TIDB_SSL=true
TIDB_SSL_CA=my-node-app/certs/isrgrootx1.pem

DB_HOST=your_tidb_host
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=smr_motors
DB_SSL=true
DB_SSL_CA=my-node-app/certs/isrgrootx1.pem
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------
# 2. Google OAuth 2.0 Authentication
# -----------------------------------------------------------------
# Create OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript Origins:
#   - http://localhost:5000
#   - https://bike-selling-site-1.onrender.com
#
# Authorized Redirect URIs:
#   - http://localhost:5000/api/auth/google/callback
#   - https://bike-selling-site-1.onrender.com/api/auth/google/callback
#
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------
# 3. Secure Administrator Credentials
# -----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smrmotors.com
ADMIN_PASSWORD_HASH=$2b$10$wT8K8U9NZb2E9p8iFqVvte7h1C1Y8fN9M.vYy4F7ZpWvXy4e.XJ6K
