# Dependencies
node_modules/
package-lock.json

# Environment variables (strictly excluded)
.env
.env.*
!.env.example
**/.env
**/my-node-app/.env

# Python artifacts
__pycache__/
*.pyc
*.pyo




# Temporary / OS files
.DS_Store
Thumbs.db
*.log
/tmp/

# Uploads directory contents (preserve folder structure)
public/uploads/*
!public/uploads/.gitkeep
my-node-app/public/uploads/*
!my-node-app/public/uploads/.gitkeep

# Local runner wrappers
powershell.bat
powershell.cmd
